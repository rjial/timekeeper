# Copy to .env.local and fill in from your Supabase project:
# Project Settings -> Data API -> Project URL and anon public key.
# Both are public by design; the anon key is safe in the browser. The write
# path is guarded by the SQL functions in supabase/schema.sql, not by this key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# The crew passphrase set by supabase/002-passphrase.sql. Used only by
# `pnpm check:supabase`; the app never reads it from the environment, it is
# typed at the console's gate.
CONSOLE_PASSPHRASE=change-me
